// --- BACKEND API ---

app.get('/api/fridge', (req, res) => {
    try {
        const fridgeItems = readData();
        res.json(fridgeItems);
    } catch (error) {
        res.status(500).json({ error: 'Błąd podczas odczytu danych.' });
    }
});

app.post('/api/fridge', (req, res) => {
    const { name, amount, unit } = req.body;
    
    if (!name || amount === undefined) {
        return res.status(400).json({ error: 'Nazwa oraz ilość są wymagane.' });
    }

    const parsedAmount = Number(amount);
    if (isNaN(parsedAmount) || parsedAmount <= 0) {
        return res.status(400).json({ error: 'Ilość musi być poprawną liczbą większą od zera.' });
    }

    const itemUnit = unit || 'szt.';
    let fridgeItems = readData();

    const existingItem = fridgeItems.find(
        item => item.name.trim().toLowerCase() === name.trim().toLowerCase() && item.unit === itemUnit
    );

    if (existingItem) {
        existingItem.amount += parsedAmount;
        writeData(fridgeItems);
        return res.status(200).json({ message: 'Zaktualizowano ilość.', item: existingItem });
    } else {
        const newItem = {
            id: Date.now().toString(),
            name: name.trim(),
            amount: parsedAmount,
            unit: itemUnit
        };
        fridgeItems.push(newItem);
        writeData(fridgeItems);
        return res.status(201).json({ message: 'Dodano nowy produkt.', item: newItem });
    }
});

app.delete('/api/fridge/:id', (req, res) => {
    const { id } = req.params;
    let fridgeItems = readData();
    const initialLength = fridgeItems.length;
    
    fridgeItems = fridgeItems.filter(i => i.id !== id);

    if (fridgeItems.length === initialLength) {
        return res.status(404).json({ error: 'Nie znaleziono produktu.' });
    }

    writeData(fridgeItems);
    res.status(204).send();
});

